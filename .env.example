# Cairn configuration.
#
# Copy to .env and fill in.  `./install.sh` does this for you and generates
# the secrets.  NEVER commit .env — CAIRN_MASTER_KEY decrypts every stored
# credential (see docs/05-quality/03-security-baseline.md §2.3).

# --- required ---------------------------------------------------------------

# 32 random bytes, base64. Generate: openssl rand -base64 32
CAIRN_MASTER_KEY=

CAIRN_DATABASE_URL=postgresql+asyncpg://cairn:cairn@postgres:5432/cairn
CAIRN_REDIS_URL=redis://redis:6379/0

# --- role -------------------------------------------------------------------
# control | data | worker | all       (ADR-0002)
CAIRN_ROLE=all

# --- general ----------------------------------------------------------------
CAIRN_ENVIRONMENT=dev
CAIRN_LOG_LEVEL=INFO
CAIRN_LOG_FORMAT=json          # json | console

# --- bootstrap (FR-A-03) ----------------------------------------------------
# Leave unset for interactive deployments: a strong password is generated and
# printed once to stdout. Set it for automated deployments — nothing is printed,
# and the forced credential change still applies.
# CAIRN_INITIAL_ADMIN_PASSWORD=

# --- database ---------------------------------------------------------------
CAIRN_DB__POOL_SIZE=20
CAIRN_DB__MAX_OVERFLOW=10
CAIRN_DB__STATEMENT_TIMEOUT_MS=30000

# --- auth -------------------------------------------------------------------
CAIRN_AUTH__SESSION_TTL_MINUTES=480
CAIRN_AUTH__CHANGE_TOKEN_TTL_MINUTES=10
CAIRN_AUTH__COOKIE_SECURE=true          # set false ONLY for local http development

# --- outbound http (NFR-SEC-09) ---------------------------------------------
CAIRN_HTTP__TIMEOUT_S=30
CAIRN_HTTP__MAX_RESPONSE_BYTES=52428800
CAIRN_HTTP__MAX_REDIRECTS=5

CAIRN_EMBEDDING__CACHE_TTL_S=604800
CAIRN_EMBEDDING__CACHE_ENABLED=true
CAIRN_EMBEDDING__QUERY_TIMEOUT_S=2
CAIRN_EMBEDDING__DOCUMENT_TIMEOUT_S=30
CAIRN_EMBEDDING__MAX_CONCURRENCY=8
CAIRN_EMBEDDING__MAX_RETRIES=3
CAIRN_EMBEDDING__CIRCUIT_FAILURE_THRESHOLD=5
CAIRN_EMBEDDING__CIRCUIT_WINDOW_S=60
CAIRN_EMBEDDING__CIRCUIT_RESET_S=30

# --- telemetry --------------------------------------------------------------
# CAIRN_TELEMETRY__OTLP_ENDPOINT=http://otel-collector:4318
CAIRN_TELEMETRY__METRICS_ENABLED=true

# --- postgres container -----------------------------------------------------
POSTGRES_USER=cairn
POSTGRES_PASSWORD=cairn
POSTGRES_DB=cairn

# --- minio container --------------------------------------------------------
MINIO_ROOT_USER=cairn
MINIO_ROOT_PASSWORD=
