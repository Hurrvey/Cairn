# Cairn configuration.
#
# Copy to .env and fill in.  `./install.sh` does this for you and generates
# the secrets.  NEVER commit .env — CAIRN_MASTER_KEY decrypts every stored
# credential (see docs/05-quality/03-security-baseline.md §2.3).

# --- required ---------------------------------------------------------------

# 32 random bytes, base64. Generate: openssl rand -base64 32
CAIRN_MASTER_KEY=

CAIRN_DATABASE_URL=postgresql+asyncpg://cairn:cairn@postgres:5432/cairn
CAIRN_REDIS_URL=redis://redis:6379/0

# --- role -------------------------------------------------------------------
# control | data | worker | all       (ADR-0002)
CAIRN_ROLE=all

# --- general ----------------------------------------------------------------
CAIRN_ENVIRONMENT=dev
CAIRN_LOG_LEVEL=INFO
CAIRN_LOG_FORMAT=json          # json | console

# --- bootstrap (FR-A-03) ----------------------------------------------------
# Leave unset for interactive deployments: a strong password is generated and
# printed once to stdout. Set it for automated deployments — nothing is printed,
# and the forced credential change still applies.
# CAIRN_INITIAL_ADMIN_PASSWORD=

# --- database ---------------------------------------------------------------
CAIRN_DB__POOL_SIZE=20
CAIRN_DB__MAX_OVERFLOW=10
CAIRN_DB__STATEMENT_TIMEOUT_MS=30000

# --- auth -------------------------------------------------------------------
CAIRN_AUTH__SESSION_TTL_MINUTES=480
CAIRN_AUTH__CHANGE_TOKEN_TTL_MINUTES=10
CAIRN_AUTH__COOKIE_SECURE=true          # set false ONLY for local http development

# --- outbound http (NFR-SEC-09) ---------------------------------------------
CAIRN_HTTP__TIMEOUT_S=30
CAIRN_HTTP__MAX_RESPONSE_BYTES=52428800
CAIRN_HTTP__MAX_REDIRECTS=5

CAIRN_EMBEDDING__CACHE_TTL_S=604800
CAIRN_EMBEDDING__CACHE_ENABLED=true
CAIRN_EMBEDDING__QUERY_TIMEOUT_S=2
CAIRN_EMBEDDING__DOCUMENT_TIMEOUT_S=30
CAIRN_EMBEDDING__MAX_CONCURRENCY=8
CAIRN_EMBEDDING__MAX_RETRIES=3
CAIRN_EMBEDDING__CIRCUIT_FAILURE_THRESHOLD=5
CAIRN_EMBEDDING__CIRCUIT_WINDOW_S=60
CAIRN_EMBEDDING__CIRCUIT_RESET_S=30

# --- retrieval data plane --------------------------------------------------
# Optional legacy endpoint overrides keyed by immutable model-provider UUID.
# UI-registered TEI/Infinity providers are projected automatically through Redis;
# the local Compose preset does not require copying provider UUIDs here.
# CAIRN_RETRIEVAL__EMBEDDING_ENDPOINTS={"20000000-0000-0000-0000-000000000002":{"dialect":"tei","base_url":"http://127.0.0.1:38742","allow_private":true,"namespace":"deployment-revision","max_batch_size":16}}
# JSON object keyed by the ACTIVE model snapshot's tokenizer_id.
# CAIRN_RETRIEVAL__TOKENIZER_FILES={"live-minilm":"D:/models/tokenizer.json"}
CAIRN_RETRIEVAL__REQUEST_TIMEOUT_S=5
CAIRN_RETRIEVAL__RUNTIME_TIMEOUT_S=0.25
CAIRN_RETRIEVAL__SEARCH_TIMEOUT_S=2

# MCP accepts server-to-server bearer API keys. Browser Origin is denied unless listed.
# Set exact externally visible hostnames when exposing through a reverse proxy.
# CAIRN_MCP__ALLOWED_HOSTS=["knowledge.example.com"]
# CAIRN_MCP__ALLOWED_ORIGINS=["https://trusted-client.example.com"]
CAIRN_MCP__MAX_REQUEST_BYTES=65536
CAIRN_MCP__REQUEST_TIMEOUT_S=15
CAIRN_MCP_PORT_MIN=8081
CAIRN_MCP_PORT_MAX=8090

# --- telemetry --------------------------------------------------------------
# CAIRN_TELEMETRY__OTLP_ENDPOINT=http://otel-collector:4318
CAIRN_TELEMETRY__METRICS_ENABLED=true

# --- qdrant (the only vector store) ------------------------------------------
# Shared by the qdrant container and the application; generate a long random value.
QDRANT_API_KEY=change-me
# Compose sets these for its services; set them when running outside Compose.
# CAIRN_QDRANT__URL=http://qdrant:6333
# CAIRN_QDRANT__TIMEOUT_S=10

# --- models -----------------------------------------------------------------
# Directory mounted read-only into the app at /models (tokenizers for every model).
# CAIRN_MODELS_ROOT=./data/models
# bge-m3 sidecar (docker compose --profile bge-m3). Prepare weights with
#   uv run python scripts/prepare_embedding_model.py --model bge-m3
# CAIRN_BGE_M3_DIR=./data/models/bge-m3
# BGE_M3_DEVICE=auto        # cpu | cuda | auto; docker-compose.gpu.yml sets cuda
# BGE_M3_API_KEY=           # optional bearer key; enter the same key on the provider

# --- postgres container -----------------------------------------------------
POSTGRES_USER=cairn
POSTGRES_PASSWORD=cairn
POSTGRES_DB=cairn

# --- supported local Compose product ---------------------------------------
CAIRN_HTTP_BIND=127.0.0.1
CAIRN_HTTP_PORT=8080
CAIRN_MODEL_DIR=./data/models/minilm
CAIRN_TASKS__RUNTIME_REFRESH_INTERVAL_S=60
CAIRN_TASKS__RUNTIME_REFRESH_BATCH_SIZE=100

# PDF parsing and local CPU OCR (English, simplified and traditional Chinese).
CAIRN_INGESTION__OCR_ENABLED=true
CAIRN_INGESTION__OCR_LANGUAGES=eng+chi_sim+chi_tra
CAIRN_INGESTION__OCR_TIMEOUT_S=45
CAIRN_INGESTION__OCR_MAX_CONCURRENCY=1

# Optional operator-configured cross-encoder endpoints, scoped to workspace UUIDs.
# The local embedding model cannot rerank. Replace endpoint and workspace before enabling.
# CAIRN_RETRIEVAL__RERANK_ENDPOINTS={"company-reranker":{"base_url":"http://reranker:80","dialect":"tei","workspace_ids":["00000000-0000-0000-0000-000000000001"],"allow_private":true}}
