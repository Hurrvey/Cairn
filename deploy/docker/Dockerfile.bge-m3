# bge-m3 sidecar (apps/bge_m3): FlagEmbedding on torch, weights mounted at /model.
#
# CPU torch by default. For NVIDIA GPUs build with
#   --build-arg TORCH_INDEX_URL=https://download.pytorch.org/whl/cu126
# or use docker-compose.gpu.yml, which also reserves the device.
FROM python:3.12-slim-bookworm@sha256:782412e85d0f0984994c290652577d4018aff08145c85b262bb63dc0c7522254

ARG TORCH_VERSION=2.14.0
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HF_HOME=/tmp/hf \
    HF_HUB_OFFLINE=1 \
    HF_DATASETS_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    BGE_M3_MODEL_PATH=/model

RUN groupadd --system --gid 10002 m3 \
 && useradd --system --uid 10002 --gid m3 --home-dir /app --shell /usr/sbin/nologin m3

WORKDIR /app
COPY apps/bge_m3/requirements.txt ./requirements.txt
# torch first, from the chosen index; the lock omits it so CPU and CUDA builds
# share every other pin.
RUN pip install --index-url "${TORCH_INDEX_URL}" "torch==${TORCH_VERSION}" \
 && pip install -r requirements.txt

COPY --chown=m3:m3 apps/bge_m3/__init__.py apps/bge_m3/server.py ./bge_m3/

USER m3
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "--factory", "bge_m3.server:create_app", \
     "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
