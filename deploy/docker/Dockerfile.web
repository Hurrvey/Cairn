# syntax=docker/dockerfile:1.7
#
# Web tier: builds the SPA and serves it, plus reverse-proxies the API.
# Runs as non-root nginx (NFR-SEC-12).

# ---------------------------------------------------------------- build
FROM node:22-alpine AS build

WORKDIR /build

# Dependency layer, cached unless the lockfile changes.
COPY apps/web/package.json apps/web/package-lock.json* ./
RUN npm ci --no-audit --no-fund 2>/dev/null || npm install --no-audit --no-fund

COPY apps/web/ ./

# The generated client must match the spec the server actually publishes.
# `api:check` fails the build on drift, so a backend contract change cannot ship
# with a stale frontend (T-M16-02).
RUN npm run api:check && npx vue-tsc --noEmit && npx vite build

# ---------------------------------------------------------------- serve
FROM nginxinc/nginx-unprivileged:1.27-alpine AS runtime

USER root
RUN rm -f /etc/nginx/conf.d/default.conf
COPY deploy/nginx/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /build/dist /usr/share/nginx/html
RUN chown -R nginx:nginx /usr/share/nginx/html
USER nginx

EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=3 \
    CMD wget -qO- http://127.0.0.1:8080/ >/dev/null || exit 1
