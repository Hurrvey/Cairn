{
  "name": "@cairn/client",
  "version": "0.1.0",
  "description": "Typed TypeScript client for Cairn",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate": "node generate-types.mjs",
    "generate:check": "node generate-types.mjs --check",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pack:check": "npm pack --dry-run"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "openapi-typescript": "7.10.1",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  },
  "engines": { "node": ">=20" },
  "license": "Apache-2.0"
}
